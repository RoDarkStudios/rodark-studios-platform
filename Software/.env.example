AUTH_SECRET=generate-a-long-random-secret
ROBLOX_OAUTH_CLIENT_ID=your-roblox-oauth-client-id
ROBLOX_OAUTH_CLIENT_SECRET=your-roblox-oauth-client-secret
# Optional: defaults to current origin + /api/auth/callback
# ROBLOX_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/callback
# Optional: defaults to "openid profile"
# ROBLOX_OAUTH_SCOPES=openid profile
# Optional: defaults to https://apis.roblox.com/oauth
# ROBLOX_OAUTH_BASE_URL=https://apis.roblox.com/oauth
# Optional: group id used for admin tab visibility (rank >= 254)
# ROBLOX_GROUP_ID=5545660
# Required for game profit tracker revenue
# Must include universe.analytics:read for every tracked universe
ROBLOX_OPEN_CLOUD_API_KEY=your-roblox-open-cloud-api-key

# Required for shared admin data storage on Railway Postgres.
DATABASE_URL=postgresql://user:password@host:port/database

# Required for paid consultation checkout.
STRIPE_SECRET_KEY=sk_live_or_test_key
# Recommended for Stripe webhook verification.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Optional: defaults to 30000 and usd.
# CONSULTATION_PRICE_CENTS=30000
# CONSULTATION_CURRENCY=usd
# Optional: comma-separated offer-code final prices in cents.
# Example link: /consultation?offer=friend50 charges $49.00 when configured below.
# CONSULTATION_DISCOUNT_OFFERS=friend50=4900,creator79=7900
# Optional: set the public production origin used for Stripe return URLs.
# PUBLIC_SITE_URL=https://rodarkstudios.com

# Required on the separate 24/7 Discord bot Railway service for all bot actions.
DISCORD_BOT_TOKEN=your-discord-bot-token
# Required only on the bot worker for contextual community moderation.
OPENAI_API_KEY=your-openai-api-key
# Moderation defaults to enabled, using gpt-5.6-luna / high once per minute per active channel.
# Set false to stop AI moderation while retaining tickets, levels and the honeypot.
# DISCORD_AI_MODERATION_ENABLED=true
# Optional: use this dedicated text channel instead of creating a private ai-moderation-log.
# Its permission overwrites will be managed by the bot to keep evidence private.
# DISCORD_MODERATION_LOG_CHANNEL_ID=your-dedicated-log-channel-id
# Optional: comma-separated moderator role IDs; defaults to Moderator/Moderators/Staff roles.
# DISCORD_MODERATOR_ROLE_IDS=your-moderator-role-id
# Optional: comma-separated channel/category IDs to exclude. Tickets and staff-only spaces are excluded automatically.
# DISCORD_MODERATION_EXCLUDED_CHANNEL_IDS=
